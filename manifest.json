{
  "manifest_version": 3,
  "name": "TalentOS Application Copilot",
  "version": "1.0.0",
  "description": "AI-assisted job application form fill: analyze a form, get a fill plan for the selected candidate, apply it, then review.",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "sidePanel", "downloads"],
  "host_permissions": ["https://*.workers.dev/*", "http://localhost:*/*"],
  "optional_host_permissions": ["https://*/*"],
  "action": { "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "popup.html" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
